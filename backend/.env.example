PORT=5001
FRONTEND_URL=http://localhost:5173

# Copy the MongoDB URI and signing key from Render into your ignored backend/.env file.
MONGODB_URL=
SECRET_KEY=
SESSION_SECRET=

# Local development can use Gmail SMTP; the Render Free plan cannot send SMTP traffic.
EMAIL_PROVIDER=smtp
SMTP_EMAIL=
SMTP_PASSWORD=

# For production, use Resend over HTTPS instead of SMTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional: for Google OAuth locally, add this callback URL to Google Cloud OAuth settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Optional: required only for Razorpay payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
